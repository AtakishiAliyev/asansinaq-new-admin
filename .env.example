VITE_SUPABASE_URL=https://bzcausrjnxdkwyewjfar.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend SMTP password, read by `supabase config push` (not used by the app).
RESEND_API_KEY=re_your_key_here

# Auth URLs, read by `supabase config push` (not used by the app). Local values
# are below; when pushing config to the HOSTED project set these to the
# deployed origin first, or production auth starts redirecting to localhost.
# Push through `npm run config:push`, which refuses a loopback URL rather than
# trusting whoever runs it to remember.
SUPABASE_AUTH_SITE_URL=http://localhost:5173
SUPABASE_AUTH_REDIRECT_WILDCARD=http://localhost:5173/**
