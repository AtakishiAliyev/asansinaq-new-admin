{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-pdfjs-wasm.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "eval": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning eval/run.ts",
    "smoke:queue": "node --disable-warning=ExperimentalWarning scripts/queue-smoke.ts",
    "smoke:verify": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/verify-smoke.ts",
    "sample:verify": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/verify-sample.ts",
    "probe:dewatermark": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/dewatermark-probe.ts",
    "sample:genlane": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/gen-lane-sample.ts",
    "sample:kinds": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/figure-kinds-sample.ts",
    "sample:guard": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/guard-calibration-sample.ts",
    "sample:corruptions": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/corruption-sample.ts",
    "requeue": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/requeue.ts",
    "figure-lane": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/figure-lane.ts",
    "smoke:answerkey": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/answer-key-smoke.ts",
    "smoke:request": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning scripts/request-smoke.ts",
    "worker": "node --import ./eval/loader.mjs --disable-warning=ExperimentalWarning worker/main.ts",
    "worker:install": "node scripts/worker-daemon.mjs install",
    "worker:uninstall": "node scripts/worker-daemon.mjs uninstall",
    "worker:status": "node scripts/worker-daemon.mjs status",
    "clean:testdata": "node --disable-warning=ExperimentalWarning scripts/clean-testdata.ts",
    "seed:categories": "node --disable-warning=ExperimentalWarning scripts/seed-categories.ts",
    "types:gen": "node scripts/gen-types.mjs",
    "config:push": "node scripts/config-push.mjs",
    "postinstall": "node scripts/copy-pdfjs-wasm.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@napi-rs/canvas": "^1.0.7",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "katex": "^0.18.4",
    "lucide-react": "^1.28.0",
    "mathjax-full": "^3.2.1",
    "mathjs": "^15.2.0",
    "pdfjs-dist": "^6.2.108",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-router": "^8.3.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
